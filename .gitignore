# Python
.env
.env.bak*
.env.*.bak
.venv/
**/__pycache__/
**/*.pyc
*.pyo
.mypy_cache/
.pytest_cache/
*.egg-info/

# Local runtime state
uploads/
logs/
tmp/
work/
pnotes/
.vscode

# Raw corpus & large data (re-fetch via scripts/scrapers; not committed)
datasets/
scripts/dataset/
raw_knowledge_base/

# Model checkpoints (large; copied in at deploy time, not committed)
models/prompt_guard_id/
models/mmbert_nli_id/

# Ingest / upload resume state
scripts/upload_state*.json
scripts/reingest_state*.json

# Eval runtime artifacts (regenerated by the harnesses)
evals/data/results/
evals/**/cache/
evals/results/
evals/**/results/*.jsonl
*.nohup

# Transient Playwright session profile
scripts/scrapers/.browser_profile/

# Local DB/vector snapshots taken before destructive migrations
backups/

.venv-mineru/
post_sidang_exp/
scripts/