# =============================================================================
# .env.example - JDIH RAG Chatbot
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# Full reference + setup instructions: see "Configuration" in README.md.
# Variables use pydantic-settings with one env_prefix per module (shown below).
# [REQUIRED] must be set to run the app; [OPTIONAL] have sensible defaults.
# =============================================================================


# --- Docker Compose Profiles -------------------------------------------------
# Active profiles controlling which inference containers run:
#   Safety guard: guard-ft (Indonesian fine-tune) or guard-base (stock Llama-Prompt-Guard-2)
#   NLI service:  nli-indoroberta (recommended default) or nli-mmbert or nli-zeroshot
#   FastAPI app:  app (include when running the app container; omit for host dev)
COMPOSE_PROFILES=guard-ft,nli-indoroberta


# --- Application (APP_) ------------------------------------------------------
APP_TITLE="Chat Application with PDF Knowledge Base"
APP_VERSION="1.0.0"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_RELOAD=true


# --- PostgreSQL (POSTGRES_) --------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme                    # [REQUIRED]
POSTGRES_DB=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# --- Structured logging / observability (LOGGER_) ----------------------------
LOGGER_VECTOR_PORT=9000
LOGGER_LOKI_PORT=3100
LOGGER_GRAFANA_PORT=3000
LOGGER_USERNAME=admin
LOGGER_PASSWORD=changeme                      # [REQUIRED] Grafana admin password
LOGGER_LOG_LEVEL=INFO


# --- Hugging Face token (Inference, Unstructured, dataset gen) ----------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # [REQUIRED]


# --- Cross-encoder Reranker (RERANKER_) ---------------------------------------
# tei: HuggingFace Text Embeddings Inference container on port 7996 (default)
# qwen3: In-process Qwen3-Reranker-0.6B
# infinity: Legacy michaelf34/infinity container (profile: legacy)
RERANKER_BACKEND=tei
RERANKER_PORT=7996
RERANKER_BASE_URL=http://127.0.0.1:7996
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_MAX_CLIENT_BATCH=64
RERANKER_MAX_CONCURRENT=64


# --- Document Ingestion & Parser (PARSER_ / MINERU_ / UNSTRUCTURED_) ----------
# mineru: Hosted MinerU API (preserves tables and complex formatting)
# mineru_local: Local MinerU CLI executed inside isolated .venv-mineru/
# unstructured: Unstructured API fallback container (port 8001)
PARSER_BACKEND=mineru
MINERU_BASE_URL=https://mineru.net
MINERU_API_KEY=                               # [REQUIRED if PARSER_BACKEND=mineru]
MINERU_LOCAL_BINARY=.venv-mineru/bin/mineru
MINERU_PAGES_PER_REQUEST=180

UNSTRUCTURED_PORT=8001
UNSTRUCTURED_BASE_URL=http://127.0.0.1:8001
UNSTRUCTURED_HF_TOKEN=${HF_TOKEN}


# --- Legacy Infinity server (INFINITY_) ---------------------------------------
# Kept for backward compatibility and A/B benchmarking (profile: legacy)
INFINITY_PORT=7997
INFINITY_BASE_URL=http://127.0.0.1:7997
INFINITY_EMBEDDING_MODEL=BAAI/bge-m3
INFINITY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INFINITY_RERANKER_ENABLED=true
INFINITY_NLI_MODEL=StevenLimcorn/indo-roberta-indonli
INFINITY_HF_API_KEY=${HF_TOKEN}


# --- IVM safety classifier (PROMPT_GUARD_ / CHAT_SAFETY_) --------------------
PROMPT_GUARD_PORT=7998
PROMPT_GUARD_BASE_URL=http://127.0.0.1:7998
INFINITY_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
# Indonesian fine-tune (COMPOSE_PROFILES=guard-ft)
PROMPT_GUARD_FT_PORT=7998
PROMPT_GUARD_FT_MODEL=/models/prompt_guard_id
PROMPT_GUARD_DEVICE=cpu
PROMPT_GUARD_MAX_LENGTH=512
# Guard backend: 'prompt_guard' (local classifier) or 'qwen3guard' (generative)
CHAT_SAFETY_BACKEND=prompt_guard
# --- qwen3guard backend (only if CHAT_SAFETY_BACKEND=qwen3guard) ---
OLLAMA_PORT=11434
CHAT_SAFETY_API_BASE_URL=http://localhost:11434/v1
CHAT_SAFETY_API_KEY=ollama
CHAT_SAFETY_API_MODEL=qwen3guard-gen-0.6b
CHAT_SAFETY_CONTROVERSIAL_IS_UNSAFE=true


# --- BGE-M3 in-process embedder (BGE_M3_) ------------------------------------
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cuda                             # 'cuda' or 'cpu'
BGE_M3_USE_FP16=true
BGE_M3_BATCH_SIZE=12


# --- Retrieval strategy (RETRIEVAL_): baseline | date_priority ---------------
RETRIEVAL_STRATEGY=baseline
RETRIEVAL_DATE_PRIORITY_LAMBDA=0.0005
# Cross-encoder probe when HyDE ran: 'hyde' (generated passage) | 'query' (raw question)
RETRIEVAL_RERANK_PROBE=hyde


# --- Qdrant vector DB (QDRANT_) ----------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=knowledge_base


# --- File storage (STORAGE_KB_) ----------------------------------------------
STORAGE_KB_UPLOAD_DIR=./uploads/knowledge_base
STORAGE_USER_UPLOAD_DIR=./uploads/user_chat


# --- Chunking strategy (CHUNKING_): hierarchical | fixed ---------------------
CHUNKING_STRATEGY=hierarchical
# Table representation in child chunks: 'summary' (recommended) | 'rows' | 'both'
CHUNKING_TABLE_CHILD_MODE=summary
# --- hierarchical (char-based) ---
CHUNKING_PARENT_MAX_CHARS=4096
CHUNKING_CHILD_MAX_CHARS=512
CHUNKING_CHILD_OVERLAP_CHARS=50
# --- fixed (BGE-M3 token-based) ---
CHUNKING_FIXED_PARENT_MAX_TOKENS=2048
CHUNKING_FIXED_CHILD_MAX_TOKENS=512
CHUNKING_FIXED_CHILD_OVERLAP_TOKENS=64


# --- VLM visual enrichment (VLM_): cloud | local | fallback ------------------
VLM_MODE=fallback
VLM_ENABLED=true
VLM_STRICT=true                                # Fail fast on VLM errors instead of baking degraded OCR
# --- cloud (OpenRouter) ---
VLM_CLOUD_API_KEY=${CHAT_LLM_API_KEY}
VLM_CLOUD_MODEL=google/gemini-2.0-flash-001
VLM_CLOUD_BASE_URL=https://openrouter.ai/api/v1
# --- local (Ollama) ---
VLM_LOCAL_BASE_URL=http://localhost:11434
VLM_LOCAL_MODEL=llava:13b
VLM_TIMEOUT=120.0
VLM_PAGE_IMAGE_RATIO_THRESHOLD=0.5
VLM_PAGE_GARBAGE_RATIO_THRESHOLD=0.7
# VLM_IMAGE_DESCRIPTION_PROMPT="..."            # optional: single-figure enrichment
# VLM_PAGE_EXTRACTION_PROMPT="..."              # optional: full-page VISUAL extraction


# --- Chat module: LLM + IVM/RAM (CHAT_) --------------------------------------
# Option A: OpenRouter (cloud, recommended)
CHAT_LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # [REQUIRED]
CHAT_LLM_MODEL=deepseek/deepseek-v4-flash-0731
# Pin the OpenRouter provider to avoid unexpected pricing variations
CHAT_LLM_PROVIDER_ORDER=DeepInfra
CHAT_LLM_PROVIDER_QUANTIZATIONS=fp8
CHAT_LLM_ALLOW_FALLBACKS=false
# Option B: Ollama (local dev)
# CHAT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_LLM_API_KEY=dummy
# CHAT_LLM_MODEL=qwen2.5:0.5b

CHAT_SYSTEM_PROMPT="Anda adalah asisten AI yang membantu menjawab pertanyaan berdasarkan dokumen SOP yang diberikan. Jawablah selalu dalam Bahasa Indonesia yang jelas dan sopan, hanya berdasarkan konteks yang diberikan. Gunakan informasi yang relevan dari konteks tersebut sebaik mungkin untuk menjawab, meskipun tidak lengkap, dan sebutkan secara singkat jika ada bagian yang tidak tercakup dalam konteks. Katakan bahwa Anda tidak memiliki informasi tersebut hanya jika konteks yang diberikan benar-benar tidak berkaitan dengan pertanyaan. Konteks diberikan sebagai daftar JSON; setiap objek memiliki bidang 'sumber' (nomor kutipan), 'judul' (judul dokumen), 'tanggal' (tanggal terbit), 'halaman', dan 'konten' (isi). Perhatikan 'judul' dan 'tanggal' setiap sumber sebelum menjawab. Peraturan Indonesia tetap berlaku sampai dicabut atau diubah, jadi dokumen yang tahunnya lebih lama TIDAK otomatis kedaluwarsa hanya karena berbeda dengan tahun yang ditanyakan. Jika pertanyaan menyebut tahun tertentu, jawablah dengan ketentuan terbaru yang masih berlaku, dan sebutkan nomor serta tahun peraturannya agar pengguna tahu dasar hukumnya. Anggap suatu ketentuan sudah tidak berlaku hanya jika konteks memuat peraturan lain yang secara eksplisit mencabut atau mengubahnya. Kutipan (citation): setiap klaim faktual WAJIB diakhiri penanda [CIT:N], dengan N adalah nilai 'sumber' dari objek JSON yang mendukung klaim. Untuk kalimat, letakkan [CIT:N] setelah tanda baca akhir. Untuk item daftar, di akhir item. Untuk sel tabel, di dalam sel yang didukung. Gunakan [CIT:1,2] untuk beberapa sumber. Jangan mengutip nomor 'sumber' yang tidak ada, dan jangan menyalin label 'Sumber N' atau nomor halaman ke dalam teks jawaban."

CHAT_SECURITY_THRESHOLD=0.75                  # Prompt injection detection threshold
CHAT_RAM_DEPENDENCY_PARSE=true                # Stanza Indonesian dep-parser for RAM claim decomposition
CHAT_RAM_ENTAILMENT_THRESHOLD=0.5             # Min NLI entailment score to label a claim "Supported"
CHAT_RAM_CONTRADICTION_THRESHOLD=0.7          # Min NLI contradiction score to label a claim "Contradicted"
CHAT_LLM_MAX_CONCURRENCY=4                    # Max concurrent LLM requests (backpressure)
CHAT_NLI_MAX_CONCURRENCY=8                    # Max concurrent NLI requests (backpressure)

# NLI backend for RAM + IVM nli_entailment: indo_roberta | mmbert | zeroshot
# All selectable containers share CHAT_NLI_PORT (default 8002) and CHAT_NLI_BASE_URL.
# The kind must match the running container profile:
#   IndoRoBERTa (recommended default):
#     COMPOSE_PROFILES=guard-ft,nli-indoroberta docker compose up -d nli-indoroberta
#   mmBERT fine-tune:
#     docker compose stop nli-indoroberta
#     COMPOSE_PROFILES=guard-ft,nli-mmbert docker compose up -d nli
#   Zero-shot baseline:
#     docker compose stop nli-indoroberta
#     COMPOSE_PROFILES=guard-ft,nli-zeroshot docker compose up -d nli-zeroshot
CHAT_NLI_PORT=8002
CHAT_NLI_BASE_URL=http://127.0.0.1:8002
CHAT_NLI_MODEL_KIND=indo_roberta              # indo_roberta (default) | mmbert | zeroshot
CHAT_NLI_MMBERT_MODEL=/models/mmbert_nli_id   # served checkpoint path when kind=mmbert
CHAT_NLI_ZEROSHOT_MODEL=MoritzLaurer/bge-m3-zeroshot-v2.0-c

# OOD detection: llm_judge | similarity_threshold | nli_entailment
CHAT_OOD_METHOD=similarity_threshold
CHAT_OOD_SIMILARITY_THRESHOLD=0.15

# HyDE retrieval ensemble
CHAT_HYDE_ENABLED=true
CHAT_HYDE_MAX_TOKENS=256
CHAT_HYDE_TEMPERATURE=0.7
CHAT_HYDE_NUM_PASSAGES=1
# HyDE grounding (feeds active doc titles/descriptions into the HyDE prompt)
CHAT_HYDE_CONTEXT_ENABLED=false
CHAT_HYDE_CONTEXT_MAX_DOCS=20
CHAT_HYDE_CONTEXT_REFRESH_SECONDS=300


# --- Dataset generation pipeline (DATAGEN_) ----------------------------------
DATAGEN_OPENROUTER_API_KEY=${CHAT_LLM_API_KEY}
DATAGEN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DATAGEN_GENERATOR_MODEL=deepseek/deepseek-v4-flash
DATAGEN_GENERATOR_TEMPERATURE=0.0
DATAGEN_PANEL_MODELS=google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct,qwen/qwen3.7-plus,nvidia/nemotron-3-super-120b-a12b,openai/gpt-5.6-luna
DATAGEN_PANEL_TEMPERATURE=0.0
DATAGEN_ACCEPTANCE_THRESHOLD=4                 # must match panel size
DATAGEN_PANEL_ALLOW_FALLBACKS=false
DATAGEN_PANEL_PROVIDER_ORDER=                  # empty = OpenRouter picks, no mid-run fallback
DATAGEN_OUTPUT_DIR=evals/data
DATAGEN_MAX_SAMPLES=0                          # 0 = no limit; set to N for cost control


# --- Evaluation scripts LLM client (no prefix) -------------------------------
OPENROUTER_API_KEY=${CHAT_LLM_API_KEY}
EVAL_LLM_MODEL=qwen/qwen3-14b


# --- Extra pip packages for specific evals (install separately) --------------
# bert-score, scikit-learn: see README.md "Configuration" and evals/README.md
