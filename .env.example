# =============================================================================
# .env.example — JDIH RAG Chatbot
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# All variables use pydantic-settings with env_prefix per domain module.
# Variables marked [REQUIRED] must be set before running the application.
# Variables marked [OPTIONAL] have sensible defaults.
# =============================================================================


# -----------------------------------------------------------------------------
# Application (prefix: APP_)
#   Source: app/shared/config.py → AppSettings
# -----------------------------------------------------------------------------
APP_TITLE="Chat Application with PDF Knowledge Base"
APP_VERSION="1.0.0"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_RELOAD=true


# -----------------------------------------------------------------------------
# PostgreSQL Database (prefix: POSTGRES_)
#   Source: app/shared/config.py → DatabaseSettings
#   Used by: docker-compose.yaml (postgres service)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme                    # [REQUIRED] Set a strong password
POSTGRES_DB=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# -----------------------------------------------------------------------------
# Structured Logging / Observability (prefix: LOGGER_)
#   Source: app/shared/config.py → LoggerSettings
#   Used by: docker-compose.yaml (loki, vector, grafana services)
# -----------------------------------------------------------------------------
LOGGER_VECTOR_PORT=9000
LOGGER_LOKI_PORT=3100
LOGGER_GRAFANA_PORT=3000
LOGGER_USERNAME=admin
LOGGER_PASSWORD=changeme                      # [REQUIRED] Grafana admin password
LOGGER_LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# Hugging Face Token
#   Used by: Infinity (model download), Unstructured API, dataset generation
#   Get token from: https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # [REQUIRED] HF read token


# -----------------------------------------------------------------------------
# Infinity Inference Server (prefix: INFINITY_)
#   Source: app/kb/config.py → KBInfinitySettings
#           app/chat/config.py → ChatConfig (infinity_url, prompt_guard_model, nli_model)
#   Used by: docker-compose.yaml (infinity service)
#   Provides: BGE-reranker-v2-m3, Llama-PG-2-86M, indo-roberta NLI.
#   NOTE: embeddings no longer come from here — Infinity's own model list
#   documents BAAI/bge-m3 as dense-only ("no sparse"), so embeddings are
#   served in-process instead (see BGE_M3_* below). INFINITY_EMBEDDING_MODEL
#   is kept only for the standalone evals/visualize/ research tooling.
# -----------------------------------------------------------------------------
INFINITY_PORT=7997
INFINITY_BASE_URL=http://127.0.0.1:7997
INFINITY_EMBEDDING_MODEL=BAAI/bge-m3
INFINITY_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
INFINITY_RERANKER_ENABLED=true                # [OPTIONAL] Toggle reranking (default: true)
INFINITY_NLI_MODEL=StevenLimcorn/indo-roberta-indonli
INFINITY_HF_API_KEY=${HF_TOKEN}

# -----------------------------------------------------------------------------
# IVM safety classifier (prefix: PROMPT_GUARD_ / CHAT_SAFETY_)
#   Source: app/chat/config.py → ChatConfig
#   Used by: docker-compose.yaml (prompt-guard service),
#            app/chat/dependency.py → get_safety_model
#
#   The guard runs on its own server, separate from INFINITY_BASE_URL, so
#   swapping the classifier restarts one small container instead of reloading
#   the reranker and NLI models with it.
# -----------------------------------------------------------------------------
PROMPT_GUARD_PORT=7998
PROMPT_GUARD_BASE_URL=http://127.0.0.1:7998
INFINITY_PROMPT_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M

# The Indonesian fine-tune, served alongside the base model on its own port so
# Exp1a can score both in one session instead of restarting between them.
#   docker compose --profile finetuned up -d prompt-guard-ft
# ./models is mounted read-only into the container, so a locally trained
# checkpoint works without pushing to the Hub first.
PROMPT_GUARD_FT_PORT=7999
PROMPT_GUARD_FT_MODEL=/models/prompt_guard_id

# To make the fine-tune the live guard for the chat app, point the base URL at
# its port: PROMPT_GUARD_BASE_URL=http://127.0.0.1:7999

# CPU by default: the 8 GB GPU already holds the reranker, the NLI model and
# the in-process embedder, and an 86M DeBERTa costs ~160ms per call on CPU —
# small next to retrieval and generation, and it keeps VRAM for the models that
# need it. The image ships CPU-only torch, so switching to cuda also means
# rebuilding with CUDA wheels.
PROMPT_GUARD_DEVICE=cpu
PROMPT_GUARD_MAX_LENGTH=512

# To evaluate the Indonesian fine-tune, point this at it and restart just the
# prompt-guard service:
#   INFINITY_PROMPT_GUARD_MODEL=your-hf-username/prompt-guard-2-86m-id
#   docker compose up -d --force-recreate prompt-guard
# The service resolves id2label from the checkpoint and logs the mapping at
# startup. Check that line: a checkpoint that declares no labels falls back to
# {0: BENIGN, 1: MALICIOUS}, and a wrong mapping inverts the guard silently.

# Which ISafetyModel adapter the IVM uses: 'prompt_guard' (local classifier,
# base or fine-tuned) or 'qwen3guard' (hosted generative guard).
CHAT_SAFETY_BACKEND=prompt_guard

# Guard backend, used when CHAT_SAFETY_BACKEND=qwen3guard. Qwen3Guard is a
# generative guard behind an OpenAI-compatible API — the same client works
# against a hosted provider or a local server, so only the base URL changes.
#
#   LOCAL (recommended here). Served as GGUF through Ollama, no external billing.
#   Qwen3Guard is NOT on OpenRouter and this account's HF Inference billing is
#   blocked (402), so local is the only working path. The `ollama create` step
#   is REQUIRED: the raw community GGUF ships a broken chat template that labels
#   everything Unsafe — see services/ollama/README.md.
#     docker compose --profile qwen up -d ollama
#     docker exec ollama_backend ollama pull hf.co/geoffmunn/Qwen3Guard-Gen-0.6B:Q8_0
#     docker cp services/ollama/Qwen3Guard-Gen-0.6B.Modelfile ollama_backend:/tmp/Modelfile
#     docker exec ollama_backend ollama create qwen3guard-gen-0.6b -f /tmp/Modelfile
#   then set:
#     CHAT_SAFETY_API_BASE_URL=http://localhost:11434/v1
#     CHAT_SAFETY_API_KEY=ollama            # any non-empty value; Ollama ignores it
#     CHAT_SAFETY_API_MODEL=qwen3guard-gen-0.6b
#   To add the 4B: see services/ollama/README.md, then
#     CHAT_SAFETY_API_MODEL=qwen3guard-gen-4b
#
#   HOSTED (only if HF Inference billing is enabled). Served by featherless-ai;
#   the HF token needs the "Make calls to Inference Providers" permission:
#     CHAT_SAFETY_API_BASE_URL=https://router.huggingface.co/v1
#     CHAT_SAFETY_API_KEY=${HF_TOKEN}
#     CHAT_SAFETY_API_MODEL=Qwen/Qwen3Guard-Gen-0.6B:featherless-ai
OLLAMA_PORT=11434
CHAT_SAFETY_API_BASE_URL=http://localhost:11434/v1
CHAT_SAFETY_API_KEY=ollama
CHAT_SAFETY_API_MODEL=qwen3guard-gen-0.6b

# Qwen3Guard emits three tiers (Safe/Controversial/Unsafe). true maps
# Controversial to unsafe, matching the fail-closed posture of the rest of the
# IVM. Fix this before running an experiment — changing it afterwards turns the
# label boundary into a tuned parameter.
CHAT_SAFETY_CONTROVERSIAL_IS_UNSAFE=true


# -----------------------------------------------------------------------------
# BGE-M3 in-process embedder (prefix: BGE_M3_)
#   Source: app/kb/config.py → BGEM3Settings
#   Used by: app/kb/infra/bge_m3_embeddings.py (loaded in-process via
#   FlagEmbedding.BGEM3FlagModel, not served over HTTP like Infinity)
# -----------------------------------------------------------------------------
BGE_M3_MODEL=BAAI/bge-m3
BGE_M3_DEVICE=cuda                            # [OPTIONAL] 'cuda' or 'cpu' (default: cuda)
BGE_M3_USE_FP16=true                          # [OPTIONAL] (default: true)
BGE_M3_BATCH_SIZE=12                          # [OPTIONAL] (default: 12)


# -----------------------------------------------------------------------------
# RAM (Response Assessment Module)
#   Used in .env to alias the NLI model
# -----------------------------------------------------------------------------
RAM_NLI_MODEL=${INFINITY_NLI_MODEL}


# -----------------------------------------------------------------------------
# Unstructured API — PDF Parser (prefix: UNSTRUCTURED_)
#   Source: app/kb/config.py → UnstructuredSettings
#   Used by: docker-compose.yaml (unstructured-api service)
# -----------------------------------------------------------------------------
UNSTRUCTURED_PORT=8001
UNSTRUCTURED_BASE_URL=http://127.0.0.1:8001
UNSTRUCTURED_HF_TOKEN=${HF_TOKEN}


# -----------------------------------------------------------------------------
# Qdrant Vector Database (prefix: QDRANT_)
#   Source: app/kb/config.py → QdrantSettings
#   Used by: docker-compose.yaml (qdrant service)
# -----------------------------------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION_NAME=knowledge_base


# -----------------------------------------------------------------------------
# File Storage (prefix: STORAGE_KB_)
#   Source: app/kb/config.py → KBStorageSettings
# -----------------------------------------------------------------------------
STORAGE_KB_UPLOAD_DIR=./uploads/knowledge_base
STORAGE_USER_UPLOAD_DIR=./uploads/user_chat


# -----------------------------------------------------------------------------
# Chunking Strategy (prefix: CHUNKING_)
#   Source: app/kb/config.py → ChunkingSettings
#   Used by: app/kb/application/ingest_worker.py (via app/rag/chunking/strategy.py)
#
#   hierarchical = heading-aware parent/child chunking (BAB/Pasal, domain-aware)
#   fixed        = fixed-size BGE-M3 token windows (domain-agnostic baseline)
#   Changing this only affects documents ingested afterwards — existing chunks
#   are not migrated; re-ingest to switch a document over.
# -----------------------------------------------------------------------------
CHUNKING_STRATEGY=hierarchical                # [OPTIONAL] hierarchical | fixed (default: hierarchical)

# --- hierarchical (character-based) ---
CHUNKING_PARENT_MAX_CHARS=4096                # [OPTIONAL] (default: 4096)
CHUNKING_CHILD_MAX_CHARS=512                  # [OPTIONAL] (default: 512)
CHUNKING_CHILD_OVERLAP_CHARS=50               # [OPTIONAL] (default: 50)

# --- fixed (BGE-M3 token-based) ---
CHUNKING_FIXED_PARENT_MAX_TOKENS=2048         # [OPTIONAL] (default: 2048)
CHUNKING_FIXED_CHILD_MAX_TOKENS=512           # [OPTIONAL] (default: 512)
CHUNKING_FIXED_CHILD_OVERLAP_TOKENS=64        # [OPTIONAL] (default: 64)


# -----------------------------------------------------------------------------
# VLM (Vision-Language Model) — figure/table/visual-page enrichment (prefix: VLM_)
#   Source: app/kb/config.py → VLMSettings
#   Used by: app/kb/application/ingest_worker.py (ingestion pipeline)
# -----------------------------------------------------------------------------
VLM_MODE=fallback                             # [OPTIONAL] 'cloud', 'local', or 'fallback' (default: fallback)
VLM_ENABLED=true                              # [OPTIONAL] Master toggle (default: true)
# --- Cloud (OpenRouter) ---
VLM_CLOUD_API_KEY=${CHAT_LLM_API_KEY}         # [OPTIONAL] Required if VLM_MODE=cloud
VLM_CLOUD_MODEL=google/gemini-2.0-flash-001
VLM_CLOUD_BASE_URL=https://openrouter.ai/api/v1
# --- Local (Ollama) ---
VLM_LOCAL_BASE_URL=http://localhost:11434
VLM_LOCAL_MODEL=llava:13b
VLM_TIMEOUT=120.0                             # [OPTIONAL] Seconds (default: 120.0)
VLM_PAGE_IMAGE_RATIO_THRESHOLD=0.5            # [OPTIONAL] Min image-element fraction for VISUAL page classification
VLM_PAGE_GARBAGE_RATIO_THRESHOLD=0.7          # [OPTIONAL] Min garbage-OCR fraction for VISUAL page classification
# Prompts (Bahasa Indonesia by default) — tune these if your KB's visual
# content differs from flowcharts/annotated screenshots/tables.
# VLM_IMAGE_DESCRIPTION_PROMPT="Deskripsikan gambar ini secara detail. ..."  # [OPTIONAL] Single-figure enrichment prompt
# VLM_PAGE_EXTRACTION_PROMPT="Ekstrak SEMUA konten dari halaman dokumen ini dalam format Markdown yang bersih. ..."  # [OPTIONAL] Full-page VISUAL extraction prompt


# -----------------------------------------------------------------------------
# Chat Module — LLM & IVM/RAM Settings (prefix: CHAT_)
#   Source: app/chat/config.py → ChatConfig
#
#   The LLM is OpenAI-compatible. Use OpenRouter, Ollama, or any compatible API.
# -----------------------------------------------------------------------------
# --- Option A: OpenRouter (cloud, recommended for thesis) ---
CHAT_LLM_BASE_URL=https://openrouter.ai/api/v1
CHAT_LLM_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # [REQUIRED] OpenRouter API key
# deepseek-v4-flash ($0.09/$0.18 per 1M, verified OpenRouter price
# 2026-07-22) instead of deepseek-v4-pro ($0.435/$0.87) — ~5x cheaper for
# everyday/default chat traffic. Exp4 (§4.10.5) evaluates the actual model
# ladder (Qwen3-8B/14B/32B) by overriding this per-run, not by using
# whatever's live here — this default only matters for ad hoc local/manual
# chat use. Revert to deepseek-v4-pro if you want the pricier model's
# quality for everyday testing; this is a cost-driven default, not a
# quality judgment.
CHAT_LLM_MODEL=deepseek/deepseek-v4-flash

# --- Option B: Ollama (local, for development) ---
# CHAT_LLM_BASE_URL=http://127.0.0.1:11434/v1
# CHAT_LLM_API_KEY=dummy
# CHAT_LLM_MODEL=qwen2.5:0.5b

CHAT_SYSTEM_PROMPT="Anda adalah asisten AI yang membantu menjawab pertanyaan berdasarkan dokumen SOP yang diberikan. Jawablah selalu dalam Bahasa Indonesia yang jelas dan sopan, hanya berdasarkan konteks yang diberikan. Gunakan informasi yang relevan dari konteks tersebut sebaik mungkin untuk menjawab, meskipun tidak lengkap, dan sebutkan secara singkat jika ada bagian yang tidak tercakup dalam konteks. Katakan bahwa Anda tidak memiliki informasi tersebut hanya jika konteks yang diberikan benar-benar tidak berkaitan dengan pertanyaan."

# IVM safety threshold
CHAT_SECURITY_THRESHOLD=0.75                  # Prompt injection detection threshold

# Conversation history replayed to the LLM. Trimmed to a token budget rather
# than a fixed message count (app/chat/application/history.py, via
# langchain_core.messages.trim_messages). Covers history only — the system
# prompt, retrieved context, and current turn are budgeted separately.
# CHAT_HISTORY_MAX_TOKENS=3000                # [OPTIONAL] default: 3000

# Follow-up query condensation. Rewrites an elliptical follow-up
# ("kenapa begitu?") into a standalone question before retrieval and the
# relevance gate, which otherwise see a query with no antecedent and abstain on
# it. Affects the search query ONLY — the safety check and the LLM prompt
# always receive the raw user message. Fails open to the raw query.
# CHAT_CONDENSE_QUERY=true                    # [OPTIONAL] default: true
# CHAT_CONDENSE_PROMPT="Anda adalah penulis ulang pertanyaan ..."             # [OPTIONAL]
# CHAT_CONDENSE_USER_TEMPLATE="Riwayat percakapan:\n{history}\n\n..."         # [OPTIONAL] {history} and {question} are replaced

# User-facing refusal/error text (Bahasa Indonesia). The out-of-domain message
# names the corpus so the user can tell a correct abstention from a bug —
# override it when loading a different KB.
# CHAT_REFUSAL_MESSAGE="Maaf, saya hanya dapat menjawab berdasarkan dokumen peraturan UPI (JDIH) ..."  # [OPTIONAL]
# CHAT_SAFETY_BLOCK_MESSAGE="Maaf, permintaan ini diblokir oleh filter keamanan ..."                   # [OPTIONAL]
# CHAT_INTERNAL_ERROR_MESSAGE="Maaf, terjadi kesalahan saat memproses permintaan Anda."                # [OPTIONAL]

# IVM relevance judge — LLM-as-judge prompt used to check if a query is
# on-topic for the retrieved context (app/guardrails/ivm/judge.py)
# CHAT_RELEVANCE_JUDGE_PROMPT="You are a relevance judge for a retrieval-augmented QA system. ..."  # [OPTIONAL]
# CHAT_RELEVANCE_JUDGE_USER_TEMPLATE="Context:\n{context}\n\nQuery: {query}\n\nIs this relevant?"  # [OPTIONAL] {context} and {query} are replaced

# IVM relevance/OOD (out-of-domain) detection method — selects which
# IRelevanceChecker backend RelevanceService uses
# (app/guardrails/ivm/checkers.py, wired in app/chat/dependency.py):
#   llm_judge            - LLM-as-judge (default; app/guardrails/ivm/judge.py)
#   similarity_threshold  - thresholds only the top retrieval (RRF-fusion)
#                           score, no extra model call; kNN-OOD framing
#                           (Sun et al., "Out-of-Distribution Detection
#                           with Deep Nearest Neighbors", ICML 2022)
#   nli_entailment        - thresholds Indonesian NLI entailment_score
#                           between query and joined KB context, reusing
#                           the RAM NLI model (Yin, Hay & Roth,
#                           "Benchmarking Zero-shot Text Classification...
#                           Entailment Approach", EMNLP 2019)
CHAT_OOD_METHOD=llm_judge                     # [OPTIONAL] llm_judge | similarity_threshold | nli_entailment (default: llm_judge)

# Only used when CHAT_OOD_METHOD=similarity_threshold. context_scores are
# Qdrant RRF-fusion scores, NOT a 0-1 cosine similarity — this default is a
# placeholder and MUST be calibrated empirically against this KB's own
# score distribution (e.g. via evals/exp1b_relevance) before relying on it.
# CHAT_OOD_SIMILARITY_THRESHOLD=0.02            # [OPTIONAL] (default: 0.02) — placeholder, calibrate empirically

# Only used when CHAT_OOD_METHOD=nli_entailment. Minimum entailment_score
# (0-1) between the query (hypothesis) and joined KB context (premise).
# CHAT_OOD_NLI_THRESHOLD=0.5                    # [OPTIONAL] (default: 0.5)

# HyDE retrieval ensemble — preserves raw-query hybrid retrieval, generates
# three hypothetical passages, averages their dense vectors, retrieves dense-only
# for that average, RRF-fuses both rankings, then uses the normal rerank/hydration path.
CHAT_HYDE_ENABLED=false                       # [OPTIONAL] (default: false; enable only after paired validation)
CHAT_HYDE_MAX_TOKENS=256                      # [OPTIONAL] (default: 256)
CHAT_HYDE_TEMPERATURE=0.0                     # [OPTIONAL] (default: 0.0)
CHAT_HYDE_NUM_PASSAGES=3                      # [OPTIONAL] (default: 3; 1–5)
# Both default prompts are defined in app/chat/config.py. The template may use
# {query} and {variant_instruction}; the latter diversifies the three passages.
# CHAT_HYDE_SYSTEM_PROMPT="Write a short Indonesian institutional-legal document passage for retrieval..."  # [OPTIONAL]
# CHAT_HYDE_PROMPT_TEMPLATE="Question: {query}\n\n{variant_instruction}\n\nRetrieval passage:"  # [OPTIONAL]

# HyDE grounding — feeds the KB's actual active document titles/descriptions
# into {kb_context} in CHAT_HYDE_SYSTEM_PROMPT (see above). Cached in-process
# with a TTL so it doesn't hit Postgres on every request.
CHAT_HYDE_CONTEXT_ENABLED=false               # [OPTIONAL] (default: false; title grounding is not original HyDE)
CHAT_HYDE_CONTEXT_MAX_DOCS=20                 # [OPTIONAL] (default: 20)
CHAT_HYDE_CONTEXT_REFRESH_SECONDS=300         # [OPTIONAL] (default: 300)



# -----------------------------------------------------------------------------
# Dataset Generation Pipeline (prefix: DATAGEN_)
#   Source: evals/_dataset_gen/config.py → DatasetGenSettings
#   Used by: build_subset_{a,b,c,d}.py scripts
#
#   Skripsi §3.2.1c:
#     - Generator: DeepSeek V3 ("deepseek-chat", $0.20/$0.80 per 1M —
#       already the cheap generator; deepseek-v4-pro was never actually
#       the code default, only an inconsistency in the thesis text
#       (Tabel 3.21), see writing/weekend_fixes_plan.md M17)
#     - Panel: 5 distinct-lab models, majority vote ≥4/5 to accept — same
#       size/quality as originally designed. Two swaps from the original
#       default, both same-lab (still 5 distinct labs) and both real mid/
#       large checkpoints, not downgrades to tiny ones: openai/gpt-5.6-luna
#       ($1.00/$6.00, ~46% of panel cost alone) → openai/gpt-oss-20b
#       ($0.029/$0.14); mistralai/mistral-large-2512 ($0.50/$1.50) →
#       mistralai/mistral-small-3.2-24b-instruct ($0.075/$0.20). Shrinking
#       the panel to fewer/weaker raters was tried and reverted as the
#       wrong lever — specific overpriced members were the actual driver.
# -----------------------------------------------------------------------------
DATAGEN_OPENROUTER_API_KEY=${CHAT_LLM_API_KEY}  # Reuse the same OpenRouter key
DATAGEN_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Generator kept out of the panel to avoid self-evaluation bias.
DATAGEN_GENERATOR_MODEL=deepseek/deepseek-v4-flash
DATAGEN_GENERATOR_TEMPERATURE=0.0
# 5 distinct-lab judges. Slugs and prices verified live against OpenRouter
# /models on 2026-07-22 (per 1M tokens, in/out):
#   gemini-2.5-flash            $0.30 / $2.50
#   llama-3.3-70b-instruct      $0.10 / $0.32
#   qwen3.7-plus                $0.32 / $1.28
#   nemotron-3-super-120b-a12b  $0.08 / $0.45   (120B MoE, 12B active)
#   gpt-5.6-luna                $1.00 / $6.00
# Each panel call's output is one label word, so input price dominates
# (~$0.36/M blended). Avoid the smallest Gemini "flash-lite" tier for judging
# specifically: empirically unreliable (bare unexplained "NO" votes / empty
# responses from an exhausted reasoning budget) — plain "flash" has not shown
# this. Avoid ':free' variants too; they are separately rate-limited.
# List position carries NO meaning: votes are gathered concurrently and
# counted equally, and there is no tie-breaker role in the code.
# Verify before any full run:  python -m app.thesis._eval._dataset_gen.preflight
DATAGEN_PANEL_MODELS=google/gemini-2.5-flash,meta-llama/llama-3.3-70b-instruct,qwen/qwen3.7-plus,nvidia/nemotron-3-super-120b-a12b,openai/gpt-5.6-luna
DATAGEN_PANEL_TEMPERATURE=0.0
DATAGEN_ACCEPTANCE_THRESHOLD=4                 # MUST match panel size in lockstep — see config.py
# One slug can be served by several upstream providers at different
# quantizations, so temperature=0.0 alone does not make a vote reproducible.
DATAGEN_PANEL_ALLOW_FALLBACKS=false
DATAGEN_PANEL_PROVIDER_ORDER=                  # empty = OpenRouter picks, but no mid-run fallback
DATAGEN_OUTPUT_DIR=evals/data
DATAGEN_MAX_SAMPLES=0                          # 0 = no limit; set to N for cost control


# -----------------------------------------------------------------------------
# Evaluation Scripts — LLM Client (direct os.environ, no prefix)
#   Source: evals/_shared/clients.py → get_llm_client_from_env()
#   Used by: exp1a_safety/run.py (prompting baseline), exp1b_relevance/run.py
#   (LLM-as-Judge, now the same production judge class), exp4_end_to_end/run.py
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=${CHAT_LLM_API_KEY}        # Reuse the same OpenRouter key
EVAL_LLM_MODEL=qwen/qwen3-14b

# Getting prompt-caching benefit across repeated eval calls: OpenRouter's
# own caching is provider-side (DeepSeek, OpenAI, Gemini 2.5, and others
# cache automatically; Anthropic/Qwen need explicit cache_control blocks),
# and it only hits if consecutive calls sharing a prefix land on the SAME
# upstream provider. OpenRouter's mechanism for that is "sticky routing" via
# a `session_id` field in the request body — NOT provider-order pinning
# (`provider.order`/`provider.only`): OpenRouter's docs state explicitly
# that manual provider ordering *disables* sticky routing, so the two are
# mutually exclusive. EvalLLMClient and EvaluatorPanel (evals/)
# both accept an optional `session_id` per call; the eval scripts pass one
# derived from the question/run id so repeated calls sharing a long context
# prefix (e.g. one dataset_gen question's per-sentence panel calls) actually
# get cached rather than re-billed in full each time. No extra config needed
# here — this is wired in code, not an env var.


# -----------------------------------------------------------------------------
# Additional Python Dependencies (not installed via pip by default)
# -----------------------------------------------------------------------------
# The following packages are needed for specific evaluation experiments:
#
#   bert-score    — Experiment 4 (end-to-end BERTScore metric)
#     Install: .venv/bin/pip install bert-score
#     Note: Requires torch (already installed) and transformers (already installed)
#
#   scikit-learn  — Used by bert-score and some metric utilities
#     Install: .venv/bin/pip install scikit-learn
